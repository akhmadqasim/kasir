{
  "expo": {
    "name": "Kasir Stok",
    "slug": "kasir-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kasir",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "id.kasir.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera dipakai untuk memindai barcode produk.",
        "NSLocalNetworkUsageDescription": "Aplikasi mencari dan terhubung ke komputer kasir di jaringan Wi-Fi toko.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "id.kasir.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera dipakai untuk memindai barcode produk.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
