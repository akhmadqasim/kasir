{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "kasir",
  "version": "1.4.1",
  "identifier": "com.kasir.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-kasir-printer.rules": "linux/70-kasir-printer.rules"
        },
        "postInstallScript": "linux/postinstall.sh",
        "postRemoveScript": "linux/postremove.sh",
        "depends": [
          "libc6 (>= 2.34)",
          "libssl3t64 | libssl3"
        ]
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-kasir-printer.rules": "linux/70-kasir-printer.rules"
        },
        "postInstallScript": "linux/postinstall.sh",
        "postRemoveScript": "linux/postremove.sh",
        "depends": [
          "libssl.so.3()(64bit)",
          "libcrypto.so.3()(64bit)"
        ]
      }
    },
    "category": "Business",
    "longDescription": "Aplikasi kasir (POS) untuk toko sembako: penjualan dengan barcode, PPOB, refund dan tukar barang, stok, laporan, dan struk thermal lewat USB atau Bluetooth."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/akhmadqasim/kasir/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRTQxOUNBNzQwQUQ4MjcKUldRbjJBcDB5aG5rUUU4VWp3cVdQbUE4NlRhYVlERmRBZjFmTDJ2aGc2S2NUVHJBSVZPVEQ5aXIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
